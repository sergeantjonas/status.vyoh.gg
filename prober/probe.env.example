# /etc/status-page/probe.env — root:root 0600, read via EnvironmentFile=-.
# One ping URL per hostname. Create one healthchecks.io check per hostname
# (slug = hostname), set its schedule to */3 minutes Europe/Brussels with
# a 2-minute grace, then copy each check's Ping URL below.
#
# Missing or empty values are silence, which healthchecks.io alerts on.

PING_vyoh_gg=
PING_api_vyoh_gg=
PING_engram_vyoh_gg=
PING_api_engram_vyoh_gg=
